#!/usr/bin/env bash
# Scan the complete index, not the working tree: partial staging cannot hide a
# secret, and unstaged/untracked local settings are never read.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo 'pre-commit: gitleaks is required; run just switch to install it.' >&2
  exit 1
fi

while IFS= read -r -d '' path; do
  case "${path##*/}" in
    .zshrc.local|.gitconfig.local|.env|.env.*)
      echo "pre-commit: refusing to commit local/private config: $path" >&2
      echo 'Keep secrets in untracked ~/.zshrc.local (or the app’s local config).' >&2
      exit 1
      ;;
  esac
  case "$path" in
    pi/README.md|pi/settings.json|pi/extensions/*) ;;
    pi/*|.pi/*)
      echo "pre-commit: refusing to commit Pi local/private state: $path" >&2
      echo 'Only pi/settings.json, pi/extensions/, and pi/README.md are portable config.' >&2
      exit 1
      ;;
  esac
  case "$path" in
    pi/*)
      case "${path##*/}" in
        auth.json|mcp-auth.json|trust.json|models-store.json|*.hm-bak|*.lock)
          echo "pre-commit: refusing to commit Pi local/private state: $path" >&2
          exit 1
          ;;
      esac
      ;;
  esac
done < <(git ls-files -z)

snapshot="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-secrets.XXXXXX")"
trap 'rm -rf "$snapshot"' EXIT
# checkout-index skips submodule contents; those repositories need their own hooks.
git checkout-index --all --prefix="$snapshot/"

# Pi writes these runtime fields into settings.json, including through symlinks.
# Reject the field names without printing their potentially identifying values.
if [ -f "$snapshot/pi/settings.json" ]; then
  status=0
  grep -Eq '"(deviceId|lastChangelogVersion)"' "$snapshot/pi/settings.json" || status=$?
  if [ "$status" -eq 0 ]; then
    echo 'pre-commit: Pi settings contain deviceId or lastChangelogVersion.' >&2
    echo 'Remove these runtime fields from pi/settings.json, then re-stage it.' >&2
    exit 1
  elif [ "$status" -ne 1 ]; then
    echo 'pre-commit: could not check Pi settings; commit blocked.' >&2
    exit 1
  fi
fi

if ! gitleaks dir "$snapshot" --config "$repo_root/.gitleaks.toml" \
    --gitleaks-ignore-path "$snapshot/.no-gitleaks-ignore" \
    --ignore-gitleaks-allow --redact=100 --no-banner --no-color --verbose; then
  echo 'pre-commit: commit blocked (possible secrets/PII, or scanner failure).' >&2
  echo 'Remove sensitive values from tracked files and put them in untracked local config.' >&2
  echo 'For shell credentials, use ~/.zshrc.local, then re-stage the cleaned file.' >&2
  exit 1
fi
