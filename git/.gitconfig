[user]
	name = Guilherme Pereira
	email = guilospanck@protonmail.com
[color]
	ui = auto
[core]
	excludesFile = ~/.gitignore
[alias]
	tree = log --oneline --decorate --all --graph
[push]
	autoSetupRemote = true
	followTags = true
[merge]
	conflictStyle = zdiff3
[init]
	defaultBranch = main
[diff]
	algorithm = histogram
[branch]
	sort = -committerdate
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.gitallowedsigners
# Per-machine: signing key, commit.gpgsign and the SSH rewrite for GitHub.
# Written by home-manager (nix/home.nix) once a Secretive key exists.
[include]
	path = ~/.gitconfig.local
